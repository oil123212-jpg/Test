{
  "name": "momo-web-playground",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "test": "playwright test",
    "build:pages": "tsc --noEmit && vite build --base=/Test/",
    "test:pages": "node scripts/test-pages.mjs",
    "start": "node scripts/serve.mjs",
    "test:server": "node --test tests/*.test.mjs",
    "test:railway": "node scripts/test-railway.mjs",
    "test:realtime": "node scripts/test-realtime.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "pg": "8.23.1",
    "ws": "8.22.1"
  }
}
